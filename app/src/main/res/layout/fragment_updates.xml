<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/DeckToolLabel" android:text="Update" />

        <com.google.android.material.card.MaterialCardView style="@style/DeckCard">
            <LinearLayout style="@style/DeckCardInner">
                <TextView
                    style="@style/DeckValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DroidDeck" />
                <TextView
                    android:id="@+id/u_version"
                    style="@style/DeckMeta" />
                <TextView
                    android:id="@+id/u_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Check for updates from GitHub."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
                <ProgressBar
                    android:id="@+id/u_dl_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progressTint="@color/cyan"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/u_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Check for updates" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/u_releases"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="View releases on GitHub" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
