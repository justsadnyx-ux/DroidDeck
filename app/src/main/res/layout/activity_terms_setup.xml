<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/welcome_terms_title"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/welcome_terms_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/terms_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:padding="14dp"
        android:clipToOutline="true">

        <TextView
            android:id="@+id/terms_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/terms_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/cyan"
        android:textSize="14sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/terms_progressbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:indeterminateTint="@color/violet"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/accept_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/accept_install"
        android:enabled="false"
        app:icon="@drawable/ic_accept" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/setup_open_terms"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/open_standalone_terms" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/setup_decline"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/decline_exit"
        android:textColor="@color/text_faint" />
</LinearLayout>
